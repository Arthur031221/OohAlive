{
  "name": "oohalive",
  "version": "0.1.0",
  "description": "Draw an arrow on a photo to make part of it move, then download the GIF. Runs in the browser, nothing is uploaded.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-timeout=60000 \"test/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=60000 \"test/e2e/*.test.js\"",
    "verify": "node scripts/verify.mjs",
    "demo": "node scripts/record-demo.mjs",
    "assets": "node scripts/make-assets.mjs"
  },
  "author": "Arthur031221",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "gif",
    "cinemagraph",
    "photo",
    "webgl",
    "animation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arthur031221/OohAlive.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "omggif": "^1.0.10",
    "playwright": "1.63.0"
  },
  "private": true
}
